# Robot settings for docker-compose.yml (changes apply on "docker compose up -d"). Any of these can also be given for
# one start, e.g.  POLICY_NAME=scratch docker compose up -d

# Wheel controller (Arduino) USB serial port on the robot computer. Prefer the stable /dev/serial/by-id/... name
# (ls -l /dev/serial/by-id/ with the Arduino plugged in): /dev/ttyUSB0 can become /dev/ttyUSB1 after replugging.
SERIAL_PORT=/dev/ttyUSB0
BAUD=115200

# balance:    self-balancing with the policy below (starts when Circle is pressed)
# wheel_test: no balancing, the controller drives the wheels directly (robot on a stand)
# bridge:     serial bridge only (for wheel_check)
MODE=balance

# policy from the library in policies/ (docker compose run --rm balance_bot policies lists them)
POLICY_NAME=smooth11

# Must match the IMU driver and whatever sends /cmd_vel
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
